DELETE {{baseUrl}}/body-metrics/{{bodyId}}
Authorization: Bearer {{authTokenB}}


###############################################################################
#                          루틴 템플릿 (/api/routines)
#
#   루틴은 "계획"이지 "기록"이 아니다. 그래서 운동 일지와 두 가지가 다르다.
#     - 날짜(date)가 없다
#     - 세트에 완료 여부(done)가 없다. 보내도 저장되지 않는다.
###############################################################################

### 70. 루틴 등록 - 기대: 201, 응답에 date가 없고 세트에 done도 없어야 한다
# @name createRoutine
POST {{baseUrl}}/routines
Content-Type: application/json
Authorization: Bearer {{authToken}}

{
  "name": "등 + 이두 루틴",
  "exercises": [
    {
      "name": "데드리프트",
      "targetMuscle": "등",
      "sets": [{ "weightKg": 120, "reps": 5 }, { "weightKg": 120, "reps": 5 }]
    },
    { "name": "랫풀다운", "targetMuscle": "등", "sets": [{ "weightKg": 55, "reps": 12 }] }
  ]
}

###
@routineId = {{createRoutine.response.body.id}}

### 71. 루틴 목록 - 기대: 200
GET {{baseUrl}}/routines
Authorization: Bearer {{authToken}}

### 72. 루틴 수정 - 기대: 200, createdAt은 그대로
PUT {{baseUrl}}/routines/{{routineId}}
Content-Type: application/json
Authorization: Bearer {{authToken}}

{
  "name": "등 루틴 (개정)",
  "exercises": [{ "name": "데드리프트", "targetMuscle": "등", "sets": [{ "weightKg": 130, "reps": 5 }] }]
}

### 72-1. done을 보내도 저장되지 않는다 - 기대: 200, 응답 세트에 done이 없어야 한다
PUT {{baseUrl}}/routines/{{routineId}}
Content-Type: application/json
Authorization: Bearer {{authToken}}

{
  "name": "등 루틴 (개정)",
  "exercises": [{ "name": "데드리프트", "sets": [{ "weightKg": 130, "reps": 5, "done": true }] }]
}

###############################################################################
#                          루틴 예외 케이스
###############################################################################

