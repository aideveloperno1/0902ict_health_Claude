GET {{baseUrl}}/meals/99999
Authorization: Bearer {{authToken}}

###############################################################################
#              35. 식단도 같은 소유권 정책이 적용된다 (사용자 B)
###############################################################################

### 35-1. B의 식단 목록 - 기대: 200, 빈 배열 (A의 식단이 보이면 안 된다)
GET {{baseUrl}}/meals
Authorization: Bearer {{authTokenB}}

### 35-2. B가 A의 식단 상세 - 기대: 404
GET {{baseUrl}}/meals/{{mealId}}
Authorization: Bearer {{authTokenB}}

