Content-Type: application/json
Authorization: Bearer {{authToken}}

{ "date": "2026-09-01", "mealType": "점심", "foods": [{ "name": "밥", "proteinG": -5 }] }

### 34-5. 음식 이름 누락 - 기대: 400
POST {{baseUrl}}/meals
Content-Type: application/json
Authorization: Bearer {{authToken}}

{ "date": "2026-09-01", "mealType": "점심", "foods": [{ "kcal": 100 }] }

