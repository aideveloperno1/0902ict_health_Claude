# 이 파일을 .env 로 복사해서 쓰세요.
#   PowerShell:  Copy-Item .env.example .env
PORT=3000

# 토큰 서명에 쓰는 비밀 키. 아무 문자열이나 넣으면 됩니다. (필수)
# 비워 두면 서버가 켜지지 않고 무엇을 해야 하는지 알려줍니다.
# 기본값을 두지 않는 이유: 코드에 적힌 기본 키는 누구나 알 수 있어서,
# 그 키를 아는 사람이 남의 토큰을 마음대로 만들어 낼 수 있기 때문입니다.
JWT_SECRET=

# 로컬 MongoDB 주소. 비밀번호가 없으므로 이 값 그대로 쓰면 됩니다.
MONGODB_URI=mongodb://127.0.0.1:27017/workout-log

# true로 두면 mongoose가 실행하는 쿼리를 터미널에 그대로 찍어 줍니다.
# 내 조건이 실제로 어떤 쿼리가 되는지 확인할 때만 잠깐 켜세요. 평소에는 로그가 너무 많습니다.
DB_DEBUG=false
